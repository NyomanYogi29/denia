{
  "name": "denia",
  "module": "index.ts",
  "bin": {
    "denia": "./src/cli/index.ts"
  },
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "bun run redis:up && bun --watch run src/index.ts",
    "dev:watch": "bun run redis:up && bun --watch run src/index.ts",
    "redis:up": "docker compose up -d redis",
    "redis:down": "docker compose down",
    "redis:logs": "docker compose logs -f redis",
    "db:push": "bunx drizzle-kit push",
    "db:generate": "bunx drizzle-kit generate",
    "db:studio": "bunx drizzle-kit studio",
    "test": "bun test"
  },
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/qrcode-terminal": "^0.12.2",
    "drizzle-kit": "^1.0.0-rc.4"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "chalk": "^6.0.0",
    "drizzle-orm": "^1.0.0-rc.4",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode-terminal": "^0.12.0",
    "readline": "^1.3.0",
    "xlsx": "^0.18.5",
    "zod": "^4.5.4"
  }
}
